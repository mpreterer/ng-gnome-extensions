<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.fireworks.visibility">
    <value nick="above" value="0"/>
    <value nick="desktop" value="1"/>
    <value nick="below" value="2"/>
  </enum>
  <schema id="org.gnome.shell.extensions.fireworks" path="/org/gnome/shell/extensions/fireworks/">
    <key name="enabled" type="b"><default>true</default><summary>Fireworks enabled</summary></key>
    <key name="visibility" enum="org.gnome.shell.extensions.fireworks.visibility"><default>'above'</default><summary>Where to show: above (over windows), desktop (only on an empty desktop), below (under windows)</summary></key>
    <key name="show-indicator" type="b"><default>true</default><summary>Show the top bar icon</summary></key>
    <key name="burst-size" type="i"><range min="30" max="250"/><default>100</default><summary>Sparks in one burst (more is heavier)</summary></key>
    <key name="placed" type="s"><default>'[]'</default><summary>Placed fireworks (JSON, internal)</summary></key>
    <key name="show-key" type="as"><default><![CDATA[['<Super><Alt>f']]]></default><summary>Hotkey: fireworks show now</summary></key>
    <key name="language" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="ru"/>
        <choice value="en"/>
      </choices>
      <default>'auto'</default>
      <summary>Interface language: auto (as in the system), ru, en</summary>
    </key>
  </schema>
</schemalist>
