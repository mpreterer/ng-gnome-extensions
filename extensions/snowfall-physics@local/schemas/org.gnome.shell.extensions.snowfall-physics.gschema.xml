<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.snowfall-physics.visibility">
    <value nick="above" value="0"/>
    <value nick="desktop" value="1"/>
    <value nick="below" value="2"/>
  </enum>
  <schema id="org.gnome.shell.extensions.snowfall-physics" path="/org/gnome/shell/extensions/snowfall-physics/">
    <key name="enabled" type="b">
      <default>true</default>
      <summary>Snow enabled</summary>
    </key>
    <key name="flake-count" type="i">
      <range min="10" max="400"/>
      <default>120</default>
      <summary>Number of falling snowflakes (recommended 80-150)</summary>
    </key>
    <key name="max-settled" type="i">
      <range min="0" max="20000"/>
      <default>6000</default>
      <summary>Maximum number of settled snowflakes</summary>
    </key>
    <key name="fps" type="i">
      <range min="10" max="60"/>
      <default>30</default>
      <summary>Frames per second (recommended 30)</summary>
    </key>
    <key name="settle-on-windows" type="b">
      <default>true</default>
      <summary>Snow settles on windows</summary>
    </key>
    <key name="settle-on-ground" type="b">
      <default>true</default>
      <summary>Snow settles at the bottom of the screen</summary>
    </key>
    <key name="melt-time" type="i">
      <range min="10" max="3600"/>
      <default>180</default>
      <summary>Average melting time of settled snow, seconds</summary>
    </key>
    <key name="wind" type="d">
      <range min="-100" max="100"/>
      <default>8</default>
      <summary>Wind, px/s (negative blows to the left)</summary>
    </key>
    <key name="shake-sensitivity" type="i">
      <range min="1" max="10"/>
      <default>5</default>
      <summary>How easily snow falls off a shaken window (1-10)</summary>
    </key>
    <key name="drift-height" type="i">
      <range min="8" max="80"/>
      <default>36</default>
      <summary>Maximum height of snow drifts on windows, px</summary>
    </key>
    <key name="drift-accumulation" type="i">
      <range min="1" max="10"/>
      <default>5</default>
      <summary>How fast drifts grow (1-10): how much height one settled flake adds</summary>
    </key>
    <key name="snowballs" type="b">
      <default>true</default>
      <summary>Roll snowballs with the mouse and stack them into snowmen</summary>
    </key>
    <key name="visibility" enum="org.gnome.shell.extensions.snowfall-physics.visibility">
      <default>'above'</default>
      <summary>Where to show: above (over windows), desktop (only on an empty desktop), below (under windows)</summary>
    </key>
    <key name="hide-in-fullscreen" type="b">
      <default>true</default>
      <summary>Hide snow when a window is fullscreen</summary>
    </key>
    <key name="show-indicator" type="b">
      <default>true</default>
      <summary>Show the top bar icon</summary>
    </key>
    <key name="toggle-key" type="as">
      <default><![CDATA[['<Super><Alt>x']]]></default>
      <summary>Hotkey to turn snow on/off</summary>
    </key>
    <key name="language" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="ru"/>
        <choice value="en"/>
      </choices>
      <default>'auto'</default>
      <summary>Interface language: auto (as in the system), ru, en</summary>
    </key>
  </schema>
</schemalist>
